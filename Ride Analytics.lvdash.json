{
  "datasets": [
    {
      "name": "cf44d482",
      "displayName": "Live KPI",
      "queryLines": [
        "SELECT\r\n",
        "    total_revenue_inr,\r\n",
        "    cancellation_rate_pct,\r\n",
        "    active_drivers,\r\n",
        "    avg_fare_inr,\r\n",
        "    CAST(\r\n",
        "        ROUND(\r\n",
        "            total_rides * (100 - cancellation_rate_pct) / 100,\r\n",
        "            0\r\n",
        "        ) AS BIGINT\r\n",
        "    ) AS completed_rides\r\n",
        "FROM gold_live_kpis;"
      ],
      "catalog": "goodcabs",
      "schema": "realtime"
    },
    {
      "name": "3b7ab368",
      "displayName": "Revenue Per Minute",
      "queryLines": [
        "SELECT\r\n",
        "    minute_bucket,\r\n",
        "    revenue_inr,\r\n",
        "    completed_rides\r\n",
        "FROM gold_revenue_per_minute\r\n",
        "ORDER BY minute_bucket;"
      ],
      "catalog": "goodcabs",
      "schema": "realtime"
    },
    {
      "name": "5681b0ed",
      "displayName": "Ride Status Mix",
      "queryLines": [
        "SELECT\r\n",
        "    status,\r\n",
        "    CAST(ride_count AS BIGINT) AS ride_count\r\n",
        "FROM goodcabs.realtime.gold_ride_status_breakdown\r\n",
        "ORDER BY ride_count DESC;"
      ]
    },
    {
      "name": "d08e4463",
      "displayName": "City Performance",
      "queryLines": [
        "SELECT\r\n",
        "    city,\r\n",
        "    ROUND(revenue_inr, 0) AS revenue_inr\r\n",
        "FROM goodcabs.realtime.gold_rides_by_city\r\n",
        "ORDER BY revenue_inr DESC;"
      ]
    },
    {
      "name": "8854ca91",
      "displayName": "Top Revenue Zones",
      "queryLines": [
        "SELECT\r\n",
        "    zone_id,\r\n",
        "    city,\r\n",
        "    ROUND(total_revenue_inr, 0) AS total_revenue_inr,\r\n",
        "    CAST(completed_rides AS BIGINT) AS completed_rides,\r\n",
        "    ROUND(avg_fare_inr, 0) AS avg_fare_inr\r\n",
        "FROM goodcabs.realtime.gold_top_zones\r\n",
        "ORDER BY total_revenue_inr DESC\r\n",
        "LIMIT 10;"
      ]
    },
    {
      "name": "989c25ae",
      "displayName": "Cncellation Reasons",
      "queryLines": [
        "SELECT\r\n",
        "    city,\r\n",
        "    COALESCE(NULLIF(cancellation_reason, ''), status) AS cancellation_reason,\r\n",
        "    COUNT(*) AS cancellation_count\r\n",
        "FROM goodcabs.realtime.gold_cancellations\r\n",
        "GROUP BY\r\n",
        "    city,\r\n",
        "    COALESCE(NULLIF(cancellation_reason, ''), status)\r\n",
        "ORDER BY cancellation_count DESC;"
      ]
    },
    {
      "name": "2122ff65",
      "displayName": "Pickup Demand",
      "queryLines": [
        "SELECT\r\n",
        "    city,\r\n",
        "    pickup_area,\r\n",
        "    zone_id,\r\n",
        "    SUM(total_rides) AS total_rides,\r\n",
        "    SUM(completed_rides) AS completed_rides,\r\n",
        "    SUM(cancelled_rides) AS cancelled_rides,\r\n",
        "    ROUND(\r\n",
        "        SUM(cancelled_rides) * 100.0 / NULLIF(SUM(total_rides), 0),\r\n",
        "        1\r\n",
        "    ) AS cancel_rate_pct\r\n",
        "FROM goodcabs.realtime.gold_pickup_demand\r\n",
        "GROUP BY city, pickup_area, zone_id\r\n",
        "ORDER BY total_rides DESC;"
      ]
    }
  ],
